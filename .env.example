NEXT_PUBLIC_APP_URL=http://localhost:3000

# IA (texto e imagem) — hub 9Router, OpenAI-compatible.
OPENAI_API_KEY=""
OPENAI_BASE_URL=http://127.0.0.1:20128/v1
OPENAI_MODEL=flash

# Supabase DEDICADO do carrossel (W97, projeto "carrossel-ia").
# Auth (GoTrue) e banco (tabela `projetos`) vêm daqui. O AutoClinic não entra
# mais no caminho do carrossel: AUTOCLINIC_AUTH_URL/AUTOCLINIC_API_URL morreram.
CARROSSEL_SUPABASE_URL=
CARROSSEL_SUPABASE_ANON_KEY=
# Só no servidor: leitura do link público (/p/<token>) e a migração. Nunca no bundle.
CARROSSEL_SUPABASE_SERVICE_ROLE_KEY=

# Opcional: diretório dos bytes das imagens (padrão <repo>/data/estudio).
# ESTUDIO_DADOS=
