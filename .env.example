# ---------------------------------------------------------------------------
# Supabase DEFINITIVO do carrossel: `carroseia-prod`
#   ref    wtncitzuebccdgekxxso
#   org    nwbjzenxwvyrtbruoyxe (CarroseIA)
#   região sa-east-1 (São Paulo)
#
# É a fonte única de auth (GoTrue) e de banco (tabela `projetos`). O projeto
# anterior (`carrossel-ia`, sjlcyghpogetolzuoziy) NÃO é apagado: ele é o rollback.
# Credenciais no cofre: /root/.ctxswap/contexts/carrossel/creds.json (campos
# CARROSSEL_PROD_*).
# ---------------------------------------------------------------------------
CARROSSEL_SUPABASE_URL=
CARROSSEL_SUPABASE_ANON_KEY=
# Só no servidor: leitura do link público (/p/<token>). Nunca no bundle — e note
# que `service_role` do projeto novo NÃO tem GRANT nas tabelas criadas por SQL
# pelo Management API (PostgREST responde 42501); quem escreve é `authenticated`,
# com RLS. Não "conserte" isso com um GRANT amplo.
CARROSSEL_SUPABASE_SERVICE_ROLE_KEY=

# Opcional (hoje o app não usa SDK no navegador; ficam aqui para qualquer cliente
# browser-side futuro). São chaves públicas por desenho.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional: diretório dos bytes das imagens (padrão <repo>/data/estudio).
# ESTUDIO_DADOS=
