[Unit]
Description=Carousel Generator (gerador de carrossel com editor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/projects/carousel-generator-eval
Environment=NODE_ENV=production
Environment=PORT=8099
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Usa o `next` instalado no proprio projeto; /usr/bin/npx nao existe nesta maquina.
ExecStart=/usr/local/bin/node node_modules/next/dist/bin/next start -p 8099 --hostname 0.0.0.0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
