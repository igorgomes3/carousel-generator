      "muted-foreground": { "value": "220 10% 66%", "type": "color" },
      "accent": { "value": "234 40% 22%", "type": "color" },
      "accent-foreground": { "value": "234 70% 82%", "type": "color" },
      "destructive": { "value": "4 62% 46%", "type": "color" },
      "destructive-foreground": { "value": "0 0% 100%", "type": "color" },
      "border": { "value": "222 14% 20%", "type": "color" },
